# ----------------------------------------------------------------
# Ollalink Translate relay — environment configuration
# Copy to .env and fill in. NEVER commit .env.
# ----------------------------------------------------------------

# HTTP port the relay listens on (app connects here)
PORT=8787

# Public-facing base of THIS relay — used to build WS URLs the app dials
# In dev: ws://localhost:8787
# In prod (e.g. Render): https://windows-live-translation-app-1.onrender.com
PUBLIC_BASE=ws://localhost:8787

# Ollalink dashboard key — sound-stream lane.
# Approved at https://login.ollalink.com → Platform → API keys.
# Pending approval right now.
OLLALINK_DASHBOARD_KEY=your_ollalink_dashboard_key_here

# Ollalink sound-stream WebSocket endpoint (realtime speech-to-speech).
# Docs: https://voices.networkershome.com/docs/realtime-speech/
OLLALINK_WS_URL=wss://sound-stream.ollalink.com/v1/speech/stream

# HMAC secret for signing app session tokens. Generate a random 32-byte hex.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_me_with_random_32_byte_hex

# How long a session token lives (seconds). Default 30 minutes.
SESSION_TTL_SECONDS=1800

# Comma-separated allowlist of CORS origins for the HTTP handshake endpoint.
# In dev the Tauri webview uses http://localhost:1420 or tauri://localhost.
ALLOWED_ORIGINS=http://localhost:1420,tauri://localhost,https://tauri.localhost

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
